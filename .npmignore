# Defense-in-depth deny-list. The real allowlist is package.json "files"
# (dist/css only, plus LICENSE / README / CHANGELOG which npm always includes).
# Keep this current so tooling, docs, and demos never ship if "files" is widened.

# VCS / editors / agents
.git
.github
.claude
.cursor
.playwright-mcp
.playwright
AGENTS.md
CLAUDE.md

# Docs, demos, sources (rebuild from the git repo, not the npm tarball)
docs
src
scripts
tests
playwright-report
test-results
pw-ci-artifacts
.netlify

# Non-CSS dist (demo HTML, favicons, media)
dist/docs
dist/demo.css
dist/favicon.ico
dist/favicon-16x16.png
dist/favicon-32x32.png
dist/apple-touch-icon.png
dist/placeholder-img-800x400.jpg
dist/video-poster.png

# Tooling configs
.editorconfig
.browserslistrc
.gitignore
.gitattributes
.npmignore
.prettierignore
.stylelintignore
.htmlvalidate.cjs
stylelint.config.js
prettier.config.js
postcss.config.js
vite.config.js
playwright.config.js
package-lock.json

# Local scratch / caches / screenshots
.tmp
.tmp-heroes
.tmp-favicon
.cache
.vite
*.log
demo-*.png
modern-demo-full.png
docs-hero-verify.png
