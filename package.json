{
  "name": "bullframe.css",
  "version": "6.2.2",
  "type": "module",
  "description": "Bullframe CSS is a lightweight CSS framework for fast, responsive, accessible UIs. Semantic by default. Any stack. Classless when you want it. System dark built in. Seven builds, solid cross-browser support.",
  "main": "dist/css/bullframe.css",
  "style": "dist/css/bullframe.css",
  "jsdelivr": "dist/css/bullframe.min.css",
  "unpkg": "dist/css/bullframe.min.css",
  "exports": {
    ".": "./dist/css/bullframe.css",
    "./dark": "./dist/css/bullframe-dark.css",
    "./system": "./dist/css/bullframe-system-default.css",
    "./classless": "./dist/css/bullframe-classless.css",
    "./classless/dark": "./dist/css/bullframe-classless-dark.css",
    "./classless/system": "./dist/css/bullframe-classless-system-default.css",
    "./utilities": "./dist/css/bullframe-utilities.css",
    "./dist/css/*": "./dist/css/*",
    "./package.json": "./package.json"
  },
  "bin": {
    "bullframe": "bin/bullframe.mjs",
    "bullframe.css": "bin/bullframe.mjs"
  },
  "files": [
    "bin/",
    "dist/css/",
    "dist/skills/",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "prepublishOnly": "npm run build && npm run skills:build",
    "lint": "stylelint \"src/**/*.css\"",
    "lint:fix": "stylelint \"src/**/*.css\" --fix",
    "lint:html": "html-validate \"src/**/*.html\"",
    "format": "prettier --write \"src/**/*.css\" \"src/**/*.html\" \"src/skills/**/*.md\" \"bin/**/*.mjs\" \"tests/**/*.mjs\" \"docs/**/*.md\" \"docs/.vitepress/**/*.css\" \"docs/.vitepress/**/*.mjs\" \"docs/.vitepress/**/*.js\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.css\" \"src/**/*.html\" \"src/skills/**/*.md\" \"bin/**/*.mjs\" \"tests/**/*.mjs\" \"docs/**/*.md\" \"docs/.vitepress/**/*.css\" \"docs/.vitepress/**/*.mjs\" \"docs/.vitepress/**/*.js\" \"scripts/**/*.mjs\"",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "test:e2e:sync-from-ci": "node scripts/sync-e2e-baselines-from-ci.mjs",
    "skills:build": "node scripts/build-skills.mjs",
    "skills:check": "node --test tests/skills/*.test.mjs",
    "skills:snapshot": "node scripts/build-skills.mjs --snapshot",
    "docs:dev": "npm run docs:sync-public && vitepress dev docs",
    "docs:sync-public": "node scripts/sync-docs-public.mjs",
    "docs:api-reference": "node scripts/build-api-reference.mjs && prettier --write docs/api-reference.md",
    "docs:sri": "node scripts/generate-sri.mjs && prettier --write docs/getting-started.md docs/theming.md docs/theming/dark-mode.md",
    "docs:build": "npm run build && npm run skills:build && npm run docs:sri && npm run docs:sync-public && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "examples:shots": "node scripts/capture-example-screenshots.mjs",
    "kitchen-sink:variants": "node scripts/generate-kitchen-sink-variants.mjs",
    "brand:icons": "node scripts/render-brand-icons.mjs",
    "brand:images": "node .github/brand/render.mjs",
    "brand:images:check": "node .github/brand/render.mjs --check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marcop135/bullframe.css.git"
  },
  "keywords": [
    "css",
    "css-framework",
    "responsive-web-design",
    "accessibility",
    "a11y",
    "dark-mode",
    "classless",
    "classless-css",
    "postcss",
    "normalize-css",
    "typography",
    "lightweight",
    "css-custom-properties",
    "theming",
    "agent-skills",
    "semantic-html",
    "html",
    "coding-agents",
    "wcag",
    "prefers-color-scheme"
  ],
  "author": "Marco Pontili",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/marcop135/bullframe.css/issues"
  },
  "homepage": "https://bullframecss.marcopontili.com",
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "autoprefixer": "^10.4.24",
    "cssnano": "^7.1.2",
    "glob": "^13.0.1",
    "html-validate": "^10.7.0",
    "playwright": "1.62.1",
    "postcss": "^8.5.12",
    "postcss-import": "^16.1.1",
    "prettier": "^3.5.3",
    "sharp": "0.35.4",
    "stylelint": "^17.1.1",
    "stylelint-config-standard": "^40.0.0",
    "vite": "^7.3.1",
    "vitepress": "^1.6.4",
    "vitepress-plugin-llms": "^1.13.4"
  },
  "engines": {
    "node": ">=20"
  }
}
