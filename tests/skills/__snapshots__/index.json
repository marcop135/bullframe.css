      "files": [
        "SKILL.md",
        "examples/contact-form.html"
      ]
    },
    {
      "name": "bullframe-landing-page",
      "description": "Build a marketing or product landing page with Bullframe CSS. Use for a hero, feature row, pricing block, call to action, or any multi-section marketing page.",
      "path": "bullframe-landing-page/SKILL.md",
      "bullframe": ">=6.1.0 <7.0.0",
      "builds": [
        "bullframe.css",
        "bullframe-dark.css",
        "bullframe-system-default.css"
      ],
      "requires": [
        "bullframe-core"
      ],
      "docs": [
        "https://bullframecss.marcopontili.com/layout",
        "https://bullframecss.marcopontili.com/utilities/grid",
        "https://bullframecss.marcopontili.com/buttons",
        "https://bullframecss.marcopontili.com/components/cards"
